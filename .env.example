DEBUG=False
SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
ALLOWED_HOSTS=apibudig.capslockdev.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://apibudig.capslockdev.com
CORS_ALLOW_ALL_ORIGINS=True

# URL publique HTTPS (liens media absolus)
PUBLIC_BASE_URL=https://apibudig.capslockdev.com

# Servir /media/ via Django si Nginx n'a pas encore location /media/
SERVE_MEDIA=True

# --- SasPay (https://docs.saspay.me) ---
# Générer dans app.saspay.me → Développeur → Clés API (sk_test_… puis sk_live_…)
SASPAY_API_KEY=
# Secret webhook (copié une seule fois à la création du webhook dans le dashboard)
# URL à enregistrer : https://apibudig.capslockdev.com/api/payments/webhook/
SASPAY_WEBHOOK_SECRET=
# Optionnel (défaut catalogue API)
# SASPAY_BASE_URL=https://api.saspay.me/api/v1
# SASPAY_FEE_CHARGE_MODE=ADD_ON
# Compat tests / ancien nom
PAYMENT_WEBHOOK_SECRET=
